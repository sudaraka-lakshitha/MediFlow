NODE_ENV=development
PORT=5000
DATABASE_URL="mysql://mediflow_user:YOUR_PASSWORD@localhost:3306/mediflow"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
# Sri Lanka Standard Time (UTC+05:30). Change this if the pharmacy operates elsewhere.
REPORT_TIMEZONE_OFFSET_MINUTES=330
EXPERIMENTAL_DDI_ENABLED=true
EXPERIMENTAL_DDI_THRESHOLD=0.85

# Email OTP password recovery. For Gmail, use a 16-character App Password,
# not your normal Google password. Keep SMTP_PASS only in backend/.env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pharmacy.mediflow@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=pharmacy.mediflow@gmail.com
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
