// Bank-transfer receipt a patient uploads after the pharmacist has sent a quotation.
// The cashier verifies it before the pharmacist is asked to prepare the medicines.
model UploadPaymentSlip {
  id               Int               @id @default(autoincrement())
  uploadId         Int               @map("upload_id")
  uploadedById     Int               @map("uploaded_by_id")
  bankAccountId    Int?              @map("bank_account_id")
  originalName     String            @map("original_name") @db.VarChar(180)
  mimeType         String            @map("mime_type") @db.VarChar(80)
  fileData         Bytes             @map("file_data") @db.LongBlob
  declaredAmount   Decimal           @map("declared_amount") @db.Decimal(12, 2)
  reference        String?           @db.VarChar(120)
  paidOn           DateTime?         @map("paid_on") @db.Date
  note             String?           @db.VarChar(500)
  status           UploadSlipStatus  @default(PENDING)
  reviewedById     Int?              @map("reviewed_by_id")
  reviewedAt       DateTime?         @map("reviewed_at")
  rejectionReason  String?           @map("rejection_reason") @db.VarChar(500)
  upload           PrescriptionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  uploadedBy       User              @relation("UploadSlipUploader", fields: [uploadedById], references: [id])
  reviewedBy       User?             @relation("UploadSlipReviewer", fields: [reviewedById], references: [id])
  bankAccount      BankAccount?      @relation(fields: [bankAccountId], references: [id])
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@index([uploadId, createdAt])
  @@index([status, createdAt])
  @@map("upload_payment_slips")
}

model PaymentRequest {
  delivery DeliveryRequest? @relation("MedicineDelivery")
  deliveryFeeFor DeliveryRequest? @relation("DeliveryFee")
  id                 Int                  @id @default(autoincrement())
  requestNumber      String               @unique @map("request_number") @db.VarChar(40)
  type               PaymentRequestType   @default(PRESCRIPTION)
  prescriptionId     Int?                 @unique @map("prescription_id")
  patientId          Int?                 @map("patient_id")
  pharmacistId       Int                  @map("pharmacist_id")
  cashierId          Int?                 @map("cashier_id")
  subtotal           Decimal              @db.Decimal(12, 2)
  discount           Decimal              @default(0) @db.Decimal(12, 2)
  containerFee       Decimal              @default(0) @map("container_fee") @db.Decimal(12, 2)
  tax                Decimal              @default(0) @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  amountPaid         Decimal              @default(0) @map("amount_paid") @db.Decimal(12, 2)
  refundedAmount     Decimal              @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  customerCancellationReason String?      @map("customer_cancellation_reason") @db.VarChar(500)
  paymentMethod      PaymentMethod?       @map("payment_method")
  paymentReference   String?              @map("payment_reference") @db.VarChar(120)
  status             PaymentRequestStatus @default(AWAITING_PAYMENT)
  couponCode         String?              @map("coupon_code") @db.VarChar(40)
  revision           Int                  @default(1)
  acknowledgedRevision Int?               @map("acknowledged_revision")
  customerAcknowledgedAt DateTime?        @map("customer_acknowledged_at") @db.DateTime(3)
  customerPaymentChoice PaymentMethod?    @map("customer_payment_choice")
  reservationDurationHours Int?           @map("reservation_duration_hours")
  reservationExpiresAt DateTime?          @map("reservation_expires_at") @db.DateTime(3)
  pharmacyNote       String?              @map("pharmacy_note") @db.VarChar(500)
  customerNote       String?              @map("customer_note") @db.VarChar(500)
  pickupPinHash      String?              @map("pickup_pin_hash") @db.VarChar(64)
  pickupPinEncrypted String?              @map("pickup_pin_encrypted") @db.VarChar(200)
  pinAttempts        Int                  @default(0) @map("pin_attempts")
  paidAt             DateTime?            @map("paid_at")
  pinVerifiedAt      DateTime?            @map("pin_verified_at")
  cancellationReason String?              @map("cancellation_reason") @db.VarChar(500)
  cancelledById      Int?                 @map("cancelled_by_id")
  cancelledAt        DateTime?            @map("cancelled_at")
  patient            User?                @relation("PaymentRequestPatient", fields: [patientId], references: [id])
  pharmacist         User                 @relation("PaymentRequestPharmacist", fields: [pharmacistId], references: [id])
  cashier            User?                @relation("PaymentRequestCashier", fields: [cashierId], references: [id])
  cancelledBy        User?                @relation("PaymentRequestCancelledBy", fields: [cancelledById], references: [id])
  prescription       Prescription?        @relation(fields: [prescriptionId], references: [id])
  items              PaymentRequestItem[]
  reservations       StockReservation[]
  slips              PaymentSlip[]
  events             PaymentRequestEvent[]
  sale               Sale?
  refunds            Refund[]
  refundApprovals    RefundApproval[]
  bankAllocations    BankTransferAllocation[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([patientId, createdAt])
  @@index([reservationExpiresAt])
  @@map("payment_requests")
}

