generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
  PATIENT
}

enum PaymentRequestStatus {
  AWAITING_PAYMENT
  // The customer says they have paid by bank transfer and has uploaded a slip; the
  // cashier still has to check it against the bank before any stock is committed.
  SLIP_SUBMITTED
  PAID
  FULFILLED
  CANCELLED
}

enum PaymentSlipStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentRequestType {
  PRESCRIPTION
  RETAIL
}

enum PrescriptionStatus {
  PENDING
  VERIFIED
  PARTIALLY_DISPENSED
  DISPENSED
  REJECTED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  DISPENSING
  RETAIL_SALE
  ADJUSTMENT
  REVERSAL
  EXPIRED
  DAMAGED
  RETURN
}

enum SaleStatus {
  PENDING
  PAID
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum RegistrationSource {
  SELF
  PHARMACIST
  ADMIN
}

enum InteractionSeverity {
  MAJOR
  MODERATE
  MINOR
  UNKNOWN
}

enum InteractionSourceType {
  CURATED
  EXPERIMENTAL
}

enum InteractionReviewStatus {
  PENDING
  ACKNOWLEDGED
  OVERRIDDEN
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  ORDER
  CATEGORY
  PRODUCT
}

enum MealTiming {
  ANY_TIME
  BEFORE_FOOD
  WITH_FOOD
  AFTER_FOOD
  EMPTY_STOMACH
}

enum UploadReviewStatus {
  PENDING
  AVAILABLE
  PARTIALLY_AVAILABLE
  UNAVAILABLE
  REJECTED
  // Rough quotation sent for the customer's process / do-not-process decision.
  QUOTE_SENT
  // Customer approved the rough quotation; pharmacist must create the final bill.
  QUOTE_ACCEPTED
  // Final structured invoice exists and awaits acknowledgement/payment choice.
  PAYMENT_PENDING
  // Patient has uploaded a bank-transfer slip; cashier needs to verify it
  PAYMENT_SUBMITTED
  // Cashier verified payment — pharmacist should prepare and create the prescription
  READY_TO_PREPARE
}

enum UploadSlipStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductType {
  MEDICINE
  NON_MEDICINAL
}

model User {
  id                          Int                       @id @default(autoincrement())
  email                       String                    @unique @db.VarChar(190)
  passwordHash                String                    @map("password_hash")
  fullName                    String                    @map("full_name") @db.VarChar(150)
  phone                       String?                   @db.VarChar(40)
  role                        Role                      @default(PATIENT)
  active                      Boolean                   @default(true)
  cashierAccess               Boolean                   @default(false) @map("cashier_access")
  pharmacyReconciliationAccess Boolean                  @default(false) @map("pharmacy_reconciliation_access")
  deliveryRefundApprovalAccess Boolean @default(false) @map("delivery_refund_approval_access")
  mustChangePassword          Boolean                   @default(false) @map("must_change_password")
  tokenVersion                Int                       @default(0) @map("token_version")
  sessionIdleMinutes          Int?                      @map("session_idle_minutes")
  lastLoginAt                 DateTime?                 @map("last_login_at")
  passwordChangedAt           DateTime?                 @map("password_changed_at")
  patientProfile              PatientProfile?
  registeredPatients          PatientProfile[]          @relation("PatientRegisteredBy")
  createdPrescriptions        Prescription[]            @relation("PrescriptionCreator")
  verifiedPrescriptions       Prescription[]            @relation("PrescriptionVerifier")
  dispensings                 Dispensing[]
  salesAsPatient              Sale[]                    @relation("SalePatient")
  salesAsPharmacist           Sale[]                    @relation("SalePharmacist")
  salesAsCashier              Sale[]                    @relation("SaleCashier")
  paymentRequestsAsPatient    PaymentRequest[]          @relation("PaymentRequestPatient")
  paymentRequestsAsPharmacist PaymentRequest[]          @relation("PaymentRequestPharmacist")
  paymentRequestsAsCashier    PaymentRequest[]          @relation("PaymentRequestCashier")
  paymentRequestsCancelled    PaymentRequest[]          @relation("PaymentRequestCancelledBy")
  stockMovements              StockMovement[]
  lowStockAcknowledgements    LowStockAcknowledgement[] @relation("LowStockAcknowledgedBy")
  auditLogs                   AuditLog[]
  reviewedInteractions        PrescriptionInteraction[] @relation("InteractionReviewer")
  createdDiscountRules        DiscountRule[]            @relation("DiscountRuleCreator")
  uploadedPrescriptions       PrescriptionUpload[]      @relation("UploadPatient")
  reviewedUploads             PrescriptionUpload[]      @relation("UploadReviewer")
  uploadSlipsUploaded         UploadPaymentSlip[]        @relation("UploadSlipUploader")
  uploadSlipsReviewed         UploadPaymentSlip[]        @relation("UploadSlipReviewer")
  patientNotices              PatientNotice[]            @relation("NoticePatient")
  noticesCreated              PatientNotice[]            @relation("NoticeCreator")
  bankAccountsCreated         BankAccount[]              @relation("BankAccountCreator")
  bankTransfers               BankTransfer[]
  paymentSlipsUploaded        PaymentSlip[]              @relation("SlipUploader")
  paymentSlipsReviewed        PaymentSlip[]              @relation("SlipReviewer")
  passwordResetOtp            PasswordResetOtp?
  authSessions                AuthSession[]
  createdAt                   DateTime                  @default(now()) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @map("updated_at")

  @@index([role, active])
  @@map("users")
}

model WorkflowLease {
  resourceKey String   @id @map("resource_key") @db.VarChar(80)
  token       String   @db.VarChar(36)
  userId      Int      @map("user_id")
  sessionId   String   @map("session_id") @db.VarChar(36)
  clientId    String   @map("client_id") @db.VarChar(36)
  expiresAt   DateTime @map("expires_at")
  processing  Boolean  @default(false)

  @@index([expiresAt])
  @@map("workflow_leases")
}

model AuthSession {
  id             String    @id @db.VarChar(36)
  userId         Int       @map("user_id")
  generation     Int       @default(0)
  lastActiveAt   DateTime  @default(now()) @map("last_active_at")
  expiresAt      DateTime  @map("expires_at")
  lockedAt       DateTime? @map("locked_at")
  revokedAt      DateTime? @map("revoked_at")
  unlockAttempts Int       @default(0) @map("unlock_attempts")
  retryAfter     DateTime? @map("retry_after")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetOtp {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  codeHash    String    @map("code_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  requestedAt DateTime  @default(now()) @map("requested_at")
  attempts    Int       @default(0)
  usedAt      DateTime? @map("used_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_otps")
}

model PatientNotice {
  id          Int      @id @default(autoincrement())
  patientId   Int      @map("patient_id")
  createdById Int      @map("created_by_id")
  title       String   @db.VarChar(150)
  message     String   @db.VarChar(1000)
  readAt      DateTime? @map("read_at")
  patient     User     @relation("NoticePatient", fields: [patientId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("NoticeCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([patientId, createdAt])
  @@map("patient_notices")
}

model PatientProfile {
  id                  Int                @id @default(autoincrement())
  userId              Int                @unique @map("user_id")
  patientNumber       String             @unique @map("patient_number") @db.VarChar(30)
  dateOfBirth         DateTime?          @map("date_of_birth") @db.Date
  address             String?            @db.VarChar(300)
  allergies           String?
  chronicConditions   String?            @map("chronic_conditions")
  registrationSource  RegistrationSource @default(SELF) @map("registration_source")
  registeredById      Int?               @map("registered_by_id")
  user                User               @relation(fields: [userId], references: [id])
  registeredBy        User?              @relation("PatientRegisteredBy", fields: [registeredById], references: [id])
  prescriptions       Prescription[]
  createdAt           DateTime           @default(now()) @map("created_at")

  @@map("patient_profiles")
}

model Category {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(100)
  description   String?        @db.VarChar(300)
  active        Boolean        @default(true)
  products      Product[]
  discountRules DiscountRule[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id                      Int                       @id @default(autoincrement())
  sku                     String                    @unique @db.VarChar(40)
  productType             ProductType               @default(MEDICINE) @map("product_type")
  genericName             String                    @map("generic_name") @db.VarChar(150)
  brandName               String?                   @map("brand_name") @db.VarChar(150)
  strength                String                    @db.VarChar(80)
  dosageForm              String                    @map("dosage_form") @db.VarChar(80)
  unit                    String                    @default("unit") @db.VarChar(40)
  manufacturerName        String?                   @map("manufacturer") @db.VarChar(150)
  manufacturerId          Int?                      @map("manufacturer_id")
  activeIngredient        String?                   @map("active_ingredient") @db.VarChar(180)
  variantGroup            String?                   @map("variant_group") @db.VarChar(100)
  barcode                 String?                   @unique @db.VarChar(80)
  rxNormCui               String?                   @map("rxnorm_cui") @db.VarChar(30)
  pubchemCid              Int?                      @map("pubchem_cid")
  smiles                  String?
  storageInstructions     String?                   @map("storage_instructions") @db.VarChar(300)
  minimumAgeYears         Int?                      @map("minimum_age_years")
  maximumAgeYears         Int?                      @map("maximum_age_years")
  drugConceptId           Int?                      @map("drug_concept_id")
  sellingPrice            Decimal                   @map("selling_price") @db.Decimal(12, 2)
  reorderLevel            Int                       @default(0) @map("reorder_level")
  prescriptionRequired    Boolean                   @default(true) @map("prescription_required")
  active                  Boolean                   @default(true)
  categoryId              Int                       @map("category_id")
  category                Category                  @relation(fields: [categoryId], references: [id])
  manufacturer            Manufacturer?             @relation(fields: [manufacturerId], references: [id])
  drugConcept             DrugConcept?              @relation(fields: [drugConceptId], references: [id])
  batches                 InventoryBatch[]
  prescriptionItems       PrescriptionItem[]
  prescriptionRetailItems PrescriptionRetailItem[]
  stockMovements          StockMovement[]
  lowStockAcknowledgement LowStockAcknowledgement?
  saleItems               SaleItem[]
  paymentRequestItems     PaymentRequestItem[]
  discountRules           DiscountRule[]
  interactionAlertsAsA    PrescriptionInteraction[] @relation("AlertProductA")
  interactionAlertsAsB    PrescriptionInteraction[] @relation("AlertProductB")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  @@index([genericName])
  @@index([categoryId, active])
  @@index([manufacturerId])
  @@index([drugConceptId])
  @@map("products")
}

model Manufacturer {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(150)
  country   String?   @db.VarChar(100)
  website   String?   @db.VarChar(250)
  phone     String?   @db.VarChar(40)
  email     String?   @db.VarChar(190)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("manufacturers")
}

model Supplier {
  id            Int              @id @default(autoincrement())
  name          String           @unique @db.VarChar(150)
  contactPerson String?          @map("contact_person") @db.VarChar(150)
  phone         String?          @db.VarChar(40)
  email         String?          @db.VarChar(190)
  address       String?          @db.VarChar(300)
  active        Boolean          @default(true)
  batches       InventoryBatch[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("suppliers")
}

model InventoryBatch {
  id                Int                @id @default(autoincrement())
  productId         Int                @map("product_id")
  supplierId        Int?               @map("supplier_id")
  batchNumber       String             @map("batch_number") @db.VarChar(80)
  quantityReceived  Decimal            @map("quantity_received") @db.Decimal(12, 3)
  quantityAvailable Decimal            @map("quantity_available") @db.Decimal(12, 3)
  quantityReserved  Decimal            @default(0) @map("quantity_reserved") @db.Decimal(12, 3)
  purchasePrice     Decimal            @map("purchase_price") @db.Decimal(12, 2)
  expiryDate        DateTime           @map("expiry_date") @db.Date
  receivedAt        DateTime           @default(now()) @map("received_at")
  restricted        Boolean            @default(false)
  restrictionReason String?            @map("restriction_reason") @db.VarChar(500)
  restrictedAt      DateTime?          @map("restricted_at") @db.DateTime(3)
  product           Product            @relation(fields: [productId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  dispensingItems   DispensingItem[]
  stockMovements    StockMovement[]
  saleItems         SaleItem[]
  reservations      StockReservation[]

  @@unique([productId, batchNumber])
  @@index([productId, receivedAt, expiryDate])
  @@index([restricted])
  @@map("inventory_batches")
}

model StockMovement {
  id             Int               @id @default(autoincrement())
  productId      Int               @map("product_id")
  batchId        Int               @map("batch_id")
  type           StockMovementType
  quantityChange Decimal           @map("quantity_change") @db.Decimal(12, 3)
  quantityBefore Decimal           @map("quantity_before") @db.Decimal(12, 3)
  quantityAfter  Decimal           @map("quantity_after") @db.Decimal(12, 3)
  referenceType  String?           @map("reference_type") @db.VarChar(40)
  referenceId    Int?              @map("reference_id")
  reason         String?           @db.VarChar(300)
  performedById  Int               @map("performed_by_id")
  product        Product           @relation(fields: [productId], references: [id])
  batch          InventoryBatch    @relation(fields: [batchId], references: [id])
  performedBy    User              @relation(fields: [performedById], references: [id])
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

model LowStockAcknowledgement {
  productId        Int      @id @map("product_id")
  stockLevel       Decimal  @map("stock_level") @db.Decimal(12, 3)
  acknowledgedById Int      @map("acknowledged_by_id")
  acknowledgedAt   DateTime @default(now()) @map("acknowledged_at")
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  acknowledgedBy   User     @relation("LowStockAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([acknowledgedById, acknowledgedAt])
  @@map("low_stock_acknowledgements")
}

model Prescription {
  id                      Int                       @id @default(autoincrement())
  prescriptionNumber      String                    @unique @map("prescription_number") @db.VarChar(40)
  patientId               Int                       @map("patient_id")
  prescriberTitle         String?                   @map("prescriber_title") @db.VarChar(20)
  prescriberName          String                    @map("prescriber_name") @db.VarChar(150)
  prescriberReference     String?                   @map("prescriber_reference") @db.VarChar(100)
  prescriptionDate        DateTime                  @map("prescription_date") @db.DateTime(3)
  status                  PrescriptionStatus        @default(PENDING)
  orderedForSelf          Boolean                   @default(true) @map("ordered_for_self")
  recipientName           String?                   @map("recipient_name") @db.VarChar(150)
  recipientRelationship   String?                   @map("recipient_relationship") @db.VarChar(100)
  recipientDateOfBirth    DateTime?                 @map("recipient_date_of_birth") @db.Date
  recipientAllergies      String?                   @map("recipient_allergies") @db.VarChar(500)
  recipientConditions     String?                   @map("recipient_conditions") @db.VarChar(500)
  notes                   String?
  pickupNote              String?                   @map("pickup_note") @db.VarChar(500)
  plannedPickupAt         DateTime?                 @map("planned_pickup_at") @db.DateTime(3)
  rejectionReason         String?                   @map("rejection_reason")
  refillsAllowed          Int                       @default(0) @map("refills_allowed")
  refillsUsed             Int                       @default(0) @map("refills_used")
  originalPrescriptionId  Int?                      @map("original_prescription_id")
  isOnline                Boolean                   @default(false) @map("is_online")
  originalPrescription    Prescription?             @relation("PrescriptionRefills", fields: [originalPrescriptionId], references: [id], onDelete: SetNull)
  refills                 Prescription[]            @relation("PrescriptionRefills")
  createdById             Int                       @map("created_by_id")
  verifiedById            Int?                      @map("verified_by_id")
  verifiedAt              DateTime?                 @map("verified_at")
  sourceUploadId          Int?                      @unique @map("source_upload_id")
  patient                 PatientProfile            @relation(fields: [patientId], references: [id])
  createdBy               User                      @relation("PrescriptionCreator", fields: [createdById], references: [id])
  verifiedBy              User?                     @relation("PrescriptionVerifier", fields: [verifiedById], references: [id])
  items                   PrescriptionItem[]
  retailItems             PrescriptionRetailItem[]
  dispensings             Dispensing[]
  interactionAlerts       PrescriptionInteraction[]
  sourceUpload            PrescriptionUpload?       @relation(fields: [sourceUploadId], references: [id], onDelete: SetNull)
  paymentRequest          PaymentRequest?
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  @@index([patientId, prescriptionDate])
  @@index([status])
  @@index([originalPrescriptionId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                  Int                  @id @default(autoincrement())
  prescriptionId      Int                  @map("prescription_id")
  productId           Int                  @map("product_id")
  quantityPerDose     Decimal              @map("quantity_per_dose") @db.Decimal(12, 3)
  doseInputAmount     Decimal?             @map("dose_input_amount") @db.Decimal(12, 3)
  doseInputUnit       String?              @map("dose_input_unit") @db.VarChar(20)
  concentrationAmount Decimal?             @map("concentration_amount") @db.Decimal(12, 3)
  concentrationUnit   String?              @map("concentration_unit") @db.VarChar(20)
  concentrationVolume Decimal?             @map("concentration_volume") @db.Decimal(12, 3)
  timesPerDay         Int                  @map("times_per_day")
  daysSupply          Int                  @map("days_supply")
  calculatedQuantity  Decimal              @map("calculated_quantity") @db.Decimal(12, 3)
  prescribedQuantity  Decimal              @map("prescribed_quantity") @db.Decimal(12, 3)
  dispensedQuantity   Decimal              @default(0) @map("dispensed_quantity") @db.Decimal(12, 3)
  cancelledQuantity   Decimal              @default(0) @map("cancelled_quantity") @db.Decimal(12, 3)
  quantityOverridden  Boolean              @default(false) @map("quantity_overridden")
  overrideReason      String?              @map("override_reason") @db.VarChar(300)
  dosageInstructions  String               @map("dosage_instructions") @db.VarChar(250)
  administrationRoute String               @default("Oral") @map("administration_route") @db.VarChar(80)
  mealTiming          MealTiming           @default(ANY_TIME) @map("meal_timing")
  asNeeded            Boolean              @default(false) @map("as_needed")
  specialInstructions String?              @map("special_instructions") @db.VarChar(500)
  frequency           String?              @db.VarChar(100)
  duration            String?              @db.VarChar(100)
  notes               String?              @db.VarChar(300)
  prescription        Prescription         @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id])
  dispensingItems     DispensingItem[]
  paymentRequestItems PaymentRequestItem[]

  @@index([prescriptionId])
  @@map("prescription_items")
}

model PrescriptionRetailItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int          @map("prescription_id")
  productId      Int          @map("product_id")
  quantity       Decimal      @db.Decimal(12, 3)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([prescriptionId, productId])
  @@index([productId])
  @@map("prescription_retail_items")
}

model Dispensing {
  id             Int              @id @default(autoincrement())
  prescriptionId Int              @map("prescription_id")
  pharmacistId   Int              @map("pharmacist_id")
  notes          String?
  reversed       Boolean          @default(false)
  reversalReason String?          @map("reversal_reason")
  prescription   Prescription     @relation(fields: [prescriptionId], references: [id])
  pharmacist     User             @relation(fields: [pharmacistId], references: [id])
  items          DispensingItem[]
  sale           Sale?
  dispensedAt    DateTime         @default(now()) @map("dispensed_at")

  @@index([dispensedAt])
  @@map("dispensings")
}

model DispensingItem {
  id                 Int              @id @default(autoincrement())
  dispensingId       Int              @map("dispensing_id")
  prescriptionItemId Int              @map("prescription_item_id")
  batchId            Int              @map("batch_id")
  quantity           Decimal          @db.Decimal(12, 3)
  unitPrice          Decimal          @map("unit_price") @db.Decimal(12, 2)
  unitCost           Decimal?         @map("unit_cost") @db.Decimal(12, 2)
  dispensing         Dispensing       @relation(fields: [dispensingId], references: [id])
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  batch              InventoryBatch   @relation(fields: [batchId], references: [id])

  @@map("dispensing_items")
}

model Sale {
  id                   Int                   @id @default(autoincrement())
  invoiceNumber        String                @unique @map("invoice_number") @db.VarChar(40)
  dispensingId         Int?                  @unique @map("dispensing_id")
  patientId            Int?                  @map("patient_id")
  pharmacistId         Int                   @map("pharmacist_id")
  cashierId            Int?                  @map("cashier_id")
  paymentRequestId     Int?                  @unique @map("payment_request_id")
  subtotal             Decimal               @db.Decimal(12, 2)
  discount             Decimal               @default(0) @db.Decimal(12, 2)
  containerFee         Decimal               @default(0) @map("container_fee") @db.Decimal(12, 2)
  tax                  Decimal               @default(0) @db.Decimal(12, 2)
  total                Decimal               @db.Decimal(12, 2)
  amountPaid           Decimal               @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentMethod        PaymentMethod         @default(CASH) @map("payment_method")
  status               SaleStatus            @default(PENDING)
  dispensing           Dispensing?           @relation(fields: [dispensingId], references: [id])
  patient              User?                 @relation("SalePatient", fields: [patientId], references: [id])
  pharmacist           User                  @relation("SalePharmacist", fields: [pharmacistId], references: [id])
  cashier              User?                 @relation("SaleCashier", fields: [cashierId], references: [id])
  paymentRequest       PaymentRequest?       @relation(fields: [paymentRequestId], references: [id])
  items                SaleItem[]
  refunds              Refund[]
  payments             SalePayment[]
  discountApplications DiscountApplication[]
  createdAt            DateTime              @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id        Int            @id @default(autoincrement())
  saleId    Int            @map("sale_id")
  productId Int            @map("product_id")
  batchId   Int            @map("batch_id")
  quantity  Decimal        @db.Decimal(12, 3)
  unitPrice Decimal        @map("unit_price") @db.Decimal(12, 2)
  unitCost  Decimal?       @map("unit_cost") @db.Decimal(12, 2)
  lineTotal Decimal        @map("line_total") @db.Decimal(12, 2)
  sale      Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  batch     InventoryBatch @relation(fields: [batchId], references: [id])

  @@map("sale_items")
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  action     String    @db.VarChar(80)
  entityType String?   @map("entity_type") @db.VarChar(80)
  entityId   Int?      @map("entity_id")
  details    Json?
  success    Boolean   @default(true)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  requestId  String?   @map("request_id") @db.VarChar(64)
